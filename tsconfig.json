{
  "extends": "ts-config-single-spa",
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationDir": "dist",
    "declarationMap": true,
    "jsx": "react-jsx",
    "target": "ES2022",
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "sourceMap": true,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "files": ["src/madie-madie-measure.tsx"],
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test*"]
}
